<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium Course Suite" verbose="1">
    <!--  suite = the entire collection of com.course.tests              -->
    <!--  name  = display name in reports                     -->
    <!--  verbose = how much detail to print (1=normal)       -->

    <listeners>
        <listener class-name="com.course.utils.ExtentTestNGListener"/>
    </listeners>

     <!-- Run Smoke Tests only -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>  <!--only smoke tests run here -->
            </run>
        </groups>
        <classes>
            <class name="com.course.tests.LoginTestng"/>
        </classes>
    </test>

    <!-- Run Regression Tests only -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.course.tests.LoginTestng"/>
        </classes>
    </test>

</suite>